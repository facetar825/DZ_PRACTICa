<Window x:Class="credit_calculation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кредитный калькулятор" Height="350" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="10,0"/>
        </Style>
        <!-- Исправлено: TargetType="TextBlock", используем Text, а не Content -->
        <Style TargetType="TextBlock" x:Key="ResultStyle">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#27AE60"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Text" Value="0"/>
            <!-- значение по умолчанию -->
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Кредитный калькулятор" FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Сумма кредита (₽):" Style="{StaticResource HeaderStyle}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="LoanAmount" Text="0" Style="{StaticResource InputStyle}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ежемесячный платёж (₽):" Style="{StaticResource HeaderStyle}" Margin="0,10,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="MonthPayment" Text="0" Style="{StaticResource InputStyle}" Margin="10,10,0,0"/>
            </Grid>
        </Border>

        <Button Grid.Row="2" Content="Рассчитать" Click="Button_Click"
                FontSize="24" FontWeight="Bold" Foreground="White"
                Background="#3498DB" BorderThickness="0"
                Height="55" Width="200" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- Исправлено: используем Text, а не Content -->
        <Border Grid.Row="3" Background="#E8F8F5" CornerRadius="10" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Срок (месяцев)" FontSize="14" Foreground="#555" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="InMonths" Style="{StaticResource ResultStyle}" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Срок (лет)" FontSize="14" Foreground="#555" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="InYears" Style="{StaticResource ResultStyle}" Text="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="Введите сумму и ежемесячный платёж, затем нажмите «Рассчитать»"
                   FontSize="12" Foreground="#888" HorizontalAlignment="Center" Margin="0,15,0,0"/>
    </Grid>
</Window>