<Window x:Class="MedicalDiary.AddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Добавление записи"
        Height="500"
        Width="400">


    <Grid Margin="20">


        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <TextBlock Text="Систолическое давление"/>

        <TextBox x:Name="SystolicBox"
         Grid.Row="1"/>



        <TextBlock Text="Диастолическое"
           Grid.Row="2"/>

        <TextBox x:Name="DiastolicBox"
         Grid.Row="3"/>




        <TextBlock Text="Пульс"
           Grid.Row="4"/>


        <TextBox x:Name="PulseBox"
         Grid.Row="5"/>





        <TextBlock Text="Сахар"
           Grid.Row="6"/>


        <TextBox x:Name="SugarBox"
         Grid.Row="7"/>




        <StackPanel Grid.Row="8"
            Margin="0,20,0,0">


            <ComboBox x:Name="MealBox">


                <ComboBoxItem>
                    Натощак
                </ComboBoxItem>


                <ComboBoxItem>
                    Через 1 час
                </ComboBoxItem>


                <ComboBoxItem>
                    Через 2 часа
                </ComboBoxItem>


            </ComboBox>



            <TextBox x:Name="CommentBox"
         Height="70"
         Margin="0,10,0,0"
         Text="Комментарий"/>



            <Button Content="Сохранить"
        Height="40"
        Margin="0,10,0,0"
        Click="Save_Click"/>


        </StackPanel>



    </Grid>


</Window>